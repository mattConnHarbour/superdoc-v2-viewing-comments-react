@@ -0,0 +1,72 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { test, expect } from '../../fixtures/superdoc.js';
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+const SAMPLE_DOC = path.resolve(__dirname, '../../fixtures/selection-sample.docx');
+
+test.skip(!fs.existsSync(SAMPLE_DOC), `Missing sample document: ${SAMPLE_DOC}`);
+test.use({
+  config: {
+    comments: 'on',
+    allowSelectionInViewMode: true,
+    showSelection: true,
+  },
+});
+
+test('creates a comment from selected text without making the document editable', async ({ page, superdoc }) => {
+  await superdoc.loadDocument(SAMPLE_DOC);
+  await superdoc.waitForStable();
+  await superdoc.setDocumentMode('viewing');
+  await superdoc.waitForStable();
+  await superdoc.assertDocumentMode('viewing');
+
+  const textBefore = await superdoc.getTextContent();
+  const selectionRect = await page.evaluate(() => {
+    const root = document.querySelector('.v2-super-editor');
+    if (!root) throw new Error('V2 document surface was not found.');
+
+    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
+    while (walker.nextNode()) {
+      const node = walker.currentNode;
+      const text = node.nodeValue ?? '';
+      const index = text.indexOf('need');
+      if (index < 0) continue;
+
+      const range = document.createRange();
+      range.setStart(node, index);
+      range.setEnd(node, index + 'need'.length);
+      const rect = range.getBoundingClientRect();
+      return { x: rect.x, y: rect.y, width: rect.width, height: rect.height };
+    }
+    throw new Error('Selection fixture text was not found.');
+  });
+
+  const y = selectionRect.y + selectionRect.height / 2;
+  await page.mouse.move(selectionRect.x + 1, y);
+  await page.mouse.down();
+  await page.mouse.move(selectionRect.x + selectionRect.width - 1, y, { steps: 6 });
+  await page.mouse.up();
+
+  await expect.poll(() => page.evaluate(() => window.getSelection()?.toString().trim())).toBe('need');
+  await expect(page.locator('.superdoc__tools [data-id="is-tool"]')).toBeVisible();
+
+  await page.locator('.superdoc__tools [data-id="is-tool"]').click();
+  const composer = page.locator('.comments-dialog.is-active textarea.superdoc-field');
+  await expect(composer).toBeVisible();
+  await composer.fill('Viewing-mode comment');
+  await page.locator('.comments-dialog.is-active .reply-btn-primary').click();
+
+  await expect
+    .poll(() =>
+      page.evaluate(async () => {
+        const result = await (window as any).superdoc?.activeEditor?.host?.getHandles?.().comments.list();
+        return (result?.items ?? []).some((comment: any) =>
+          String(comment?.text ?? comment?.commentText ?? '').includes('Viewing-mode comment'),
+        );
+      }),
+    )
+    .toBe(true);
+  expect(await superdoc.getTextContent()).toBe(textBefore);
+});
